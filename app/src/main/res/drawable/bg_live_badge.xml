<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Au bord du direct : pastille rouge pleine -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/popcorn_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- En retard sur le direct : contour rouge, tap pour revenir au live -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/popcorn_red" />
        </shape>
    </item>
</selector>
